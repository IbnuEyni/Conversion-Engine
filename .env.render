# === Production Environment Variables for Render ===
# Copy these to your Render service environment variables

# === LLM ===
OPENROUTER_API_KEY=<your_openrouter_key>
DEV_MODEL=qwen/qwen3-235b-a22b
EVAL_MODEL=anthropic/claude-sonnet-4
DEV_TEMPERATURE=0.3
EVAL_TEMPERATURE=0.0

# === Email (Resend) ===
RESEND_API_KEY=<your_resend_key>
FROM_EMAIL=onboarding@resend.dev
# UPDATE THIS after Render deployment:
REPLY_WEBHOOK_URL=https://YOUR-APP-NAME.onrender.com/webhooks/email/reply

# === SMS (Africa's Talking) ===
AT_USERNAME=sandbox
AT_API_KEY=<your_africastalking_key>
AT_SHORTCODE=4571
# UPDATE THIS after Render deployment:
AT_WEBHOOK_URL=https://YOUR-APP-NAME.onrender.com/webhooks/sms/inbound

# === HubSpot ===
HUBSPOT_ACCESS_TOKEN=<your_hubspot_token>
HUBSPOT_PORTAL_ID=<your_portal_id>

# === Cal.com ===
CALCOM_API_KEY=<your_calcom_key>
CALCOM_BASE_URL=http://localhost:3000
CALCOM_EVENT_TYPE_ID=1

# === Langfuse ===
LANGFUSE_SECRET_KEY=<your_langfuse_secret>
LANGFUSE_PUBLIC_KEY=<your_langfuse_public>
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# === Kill Switch ===
LIVE_MODE=false
OUTBOUND_SINK=local

# === Data Paths ===
CRUNCHBASE_DATA_PATH=data/crunchbase/crunchbase_sample.json
LAYOFFS_DATA_PATH=data/layoffs/layoffs.csv
JOB_POSTS_PATH=data/job_posts/
SEED_DATA_PATH=seed_data/